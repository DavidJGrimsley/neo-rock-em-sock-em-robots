     if (!state.live || generation != state.generation) {
@@ -675,3 +689,33 @@
     ++s.revision;
     return JNI_TRUE;
 }
+
+// Join by globally unique seq from nativeRead; never pair a newer grip with an older aim sample.
+extern "C" JNIEXPORT jboolean JNICALL
+Java_expo_modules_questinput_QuestInputModule_nativeReadGrip(
+        JNIEnv *env,jobject,jlongArray longs,jint count,jintArray ints,jfloatArray floats) {
+    using namespace quest_input;
+    if (count<0||count>kCapacity||!longs||!ints||!floats||env->GetArrayLength(longs)<count*3||
+        env->GetArrayLength(ints)<count*8||env->GetArrayLength(floats)<count*26) return JNI_FALSE;
+    std::array<jlong,kCapacity*3> seqs{};
+    std::array<jint,kCapacity*8> gi{};
+    std::array<jfloat,kCapacity*26> gf{};
+    env->GetLongArrayRegion(longs,0,count*3,seqs.data());
+    {
+        std::lock_guard<std::mutex> lock(state.mutex);
+        for (int i=0;i<count;++i) {
+            const int64_t seq=seqs[i*3];
+            if (seq<=0||!state.live||seq<state.oldestSeq||seq>state.latestSeq) {
+                gi[i*8]=-12; gi[i*8+4]=-12; continue;
+            }
+            const auto &slot=state.ring[static_cast<size_t>(seq%kCapacity)];
+            if (slot.longs[0]==seq) {
+                std::copy(slot.gripInts,slot.gripInts+8,gi.data()+i*8);
+                std::copy(slot.gripFloats,slot.gripFloats+26,gf.data()+i*26);
+            } else { gi[i*8]=-12; gi[i*8+4]=-12; } // overwritten: inactive/lost, never stale alias
+        }
+    }
+    env->SetIntArrayRegion(ints,0,count*8,gi.data());
+    env->SetFloatArrayRegion(floats,0,count*26,gf.data());
+    return JNI_TRUE;
+}
