@@ -818,6 +818,30 @@ void VROInputControllerOpenXR::triggerHaptic(XrSession session, int hand,
     xrApplyHapticFeedback(session, &info, (const XrHapticBaseHeader *)&vibration);
 }
 
+XrResult VROInputControllerOpenXR::applyQuestHaptic(XrSession session, int hand,
+                                                    float amplitude, float durationSec) const {
+    if (session == XR_NULL_HANDLE) return XR_ERROR_HANDLE_INVALID;
+    if (hand != 0 && hand != 1) return XR_ERROR_VALIDATION_FAILURE;
+    XrAction vibrateAction = (hand == 0) ? _leftVibrateAction : _rightVibrateAction;
+    if (vibrateAction == XR_NULL_HANDLE) return XR_ERROR_HANDLE_INVALID;
+
+    const float clampedAmp = std::isfinite(amplitude)
+        ? (amplitude < 0.0f ? 0.0f : (amplitude > 1.0f ? 1.0f : amplitude))
+        : 0.0f;
+    const float clampedSec = std::isfinite(durationSec)
+        ? (durationSec < 0.001f ? 0.001f : (durationSec > 0.5f ? 0.5f : durationSec))
+        : 0.02f;
+
+    XrHapticVibration vibration = { XR_TYPE_HAPTIC_VIBRATION };
+    vibration.amplitude  = clampedAmp;
+    vibration.duration   = static_cast<XrDuration>(clampedSec * 1e9f);
+    vibration.frequency  = XR_FREQUENCY_UNSPECIFIED;
+
+    XrHapticActionInfo info = { XR_TYPE_HAPTIC_ACTION_INFO };
+    info.action = vibrateAction;
+    return xrApplyHapticFeedback(session, &info, (const XrHapticBaseHeader *)&vibration);
+}
+
