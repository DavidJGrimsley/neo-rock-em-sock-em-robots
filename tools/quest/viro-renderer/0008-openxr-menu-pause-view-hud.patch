diff --git a/android/sharedCode/src/main/cpp/VROSceneRendererOpenXR.cpp b/android/sharedCode/src/main/cpp/VROSceneRendererOpenXR.cpp
index a3ba9a0..cfc05e1 100644
--- a/android/sharedCode/src/main/cpp/VROSceneRendererOpenXR.cpp
+++ b/android/sharedCode/src/main/cpp/VROSceneRendererOpenXR.cpp
@@ -578,6 +578,15 @@ bool VROSceneRendererOpenXR::createReferenceSpace() {
         return false;
     }
     ALOGV("Reference space created (LOCAL — eye-level origin)");
+
+    XrReferenceSpaceCreateInfo viewInfo = { XR_TYPE_REFERENCE_SPACE_CREATE_INFO };
+    viewInfo.referenceSpaceType   = XR_REFERENCE_SPACE_TYPE_VIEW;
+    viewInfo.poseInReferenceSpace = { {0, 0, 0, 1}, {0, 0, 0} };
+    XrResult vr = xrCreateReferenceSpace(_session, &viewInfo, &_viewSpace);
+    if (XR_FAILED(vr)) {
+        ALOGW("VIEW reference space creation failed: %d", vr);
+        _viewSpace = XR_NULL_HANDLE;
+    }
     return true;
 }
 
@@ -917,6 +926,10 @@ void VROSceneRendererOpenXR::destroySession() {
         _passthrough = XR_NULL_HANDLE;
     }
     destroySwapchains();
+    if (_viewSpace != XR_NULL_HANDLE) {
+        xrDestroySpace(_viewSpace);
+        _viewSpace = XR_NULL_HANDLE;
+    }
     if (_stageSpace != XR_NULL_HANDLE) {
         xrDestroySpace(_stageSpace);
         _stageSpace = XR_NULL_HANDLE;
@@ -1461,7 +1474,7 @@ void VROSceneRendererOpenXR::renderFrame() {
     // Floating transparent branded title overlay (QuestPanelLayer.h), over the scene.
     const XrCompositionLayerBaseHeader *questTitlePanel = nullptr;
     if (viewsValid && frameState.shouldRender && _questPanel) {
-        questTitlePanel = _questPanel->prepareTitle(_session, _stageSpace);
+        questTitlePanel = _questPanel->prepareTitle(_session, _stageSpace, _viewSpace);
     }
     if (questTitlePanel) layers.push_back(questTitlePanel);
 
