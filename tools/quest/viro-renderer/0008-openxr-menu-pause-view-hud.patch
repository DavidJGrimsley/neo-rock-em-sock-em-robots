-    // ── Menu button (left hand → BackButton) ─────────────────────────────────
+    // ── Menu button (left hand → app-handled pause via QuestInputSampler) ───
     {
         XrActionStateBoolean state  = { XR_TYPE_ACTION_STATE_BOOLEAN };
