+namespace {
+struct SkeletalPoseSample {
+    VROVector3f t;
+    VROQuaternion q;
+    VROVector3f s;
+    bool valid = false;
+};
+
+SkeletalPoseSample decomposeBoneMatrix(const VROMatrix4f &m) {
+    SkeletalPoseSample out;
+    out.s = m.extractScale();
+    if (out.s.x < 1e-6f || out.s.y < 1e-6f || out.s.z < 1e-6f) {
+        return out;
+    }
+    float c0x = m[0] / out.s.x, c0y = m[1] / out.s.x, c0z = m[2] / out.s.x;
+    float c1x = m[4] / out.s.y, c1y = m[5] / out.s.y, c1z = m[6] / out.s.y;
+    float c2x = m[8] / out.s.z, c2y = m[9] / out.s.z, c2z = m[10] / out.s.z;
+    float det = c0x * (c1y * c2z - c1z * c2y)
+              - c1x * (c0y * c2z - c0z * c2y)
+              + c2x * (c0y * c1z - c0z * c1y);
+    if (det <= 0.0f) {
+        return out;
+    }
+    out.t = m.extractTranslation();
+    out.q = m.extractRotation(out.s);
+    out.q.normalize();
+    out.valid = true;
+    return out;
+}
+
+VROMatrix4f composeBoneMatrix(const VROVector3f &t, const VROQuaternion &q, const VROVector3f &s) {
+    VROMatrix4f m = q.getMatrix();
+    m[0] *= s.x; m[1] *= s.x; m[2] *= s.x;
+    m[4] *= s.y; m[5] *= s.y; m[6] *= s.y;
+    m[8] *= s.z; m[9] *= s.z; m[10] *= s.z;
+    m[12] = t.x; m[13] = t.y; m[14] = t.z;
+    return m;
+}
+
+class VROSkeletalBoneAnimation : public VROAnimation {
+public:
+    VROSkeletalBoneAnimation(std::function<void(VROAnimatable *const, VROMatrix4f)> method,
+                           std::vector<float> keyTimes,
+                           std::vector<VROMatrix4f> keyValues,
+                           SkeletalPoseSample startPose,
+                           float blendFraction)
+        : VROAnimation(),
+          _keyTimes(std::move(keyTimes)),
+          _keyValues(std::move(keyValues)),
+          _method(std::move(method)),
+          _startPose(startPose),
+          _blendFraction(blendFraction) {}
+
+    void processAnimationFrame(float t) override {
+        VROMatrix4f value = VROMathInterpolateKeyFrameMatrix4f(t, _keyTimes, _keyValues);
+        if (_startPose.valid && _blendFraction > 0.0f && t < _blendFraction) {
+            float u = std::max(0.0f, std::min(1.0f, t / _blendFraction));
+            float w = u * u * (3.0f - 2.0f * u);
+            SkeletalPoseSample targetPose = decomposeBoneMatrix(value);
+            if (targetPose.valid) {
+                VROVector3f tBlend(
+                    _startPose.t.x + (targetPose.t.x - _startPose.t.x) * w,
+                    _startPose.t.y + (targetPose.t.y - _startPose.t.y) * w,
+                    _startPose.t.z + (targetPose.t.z - _startPose.t.z) * w
+                );
+                VROQuaternion qBlend = VROQuaternion::slerp(_startPose.q, targetPose.q, w);
+                qBlend.normalize();
+                VROVector3f sBlend(
+                    _startPose.s.x + (targetPose.s.x - _startPose.s.x) * w,
+                    _startPose.s.y + (targetPose.s.y - _startPose.s.y) * w,
+                    _startPose.s.z + (targetPose.s.z - _startPose.s.z) * w
+                );
+                value = composeBoneMatrix(tBlend, qBlend, sBlend);
+            }
+        }
+        std::shared_ptr<VROAnimatable> animatable = _animatable.lock();
+        if (animatable) {
+            _method(animatable.get(), value);
+        }
+    }
+
+    void finish() override {
+        std::shared_ptr<VROAnimatable> animatable = _animatable.lock();
+        if (animatable) {
+            _method(animatable.get(), _keyValues.back());
+        }
+    }
+
+private:
+    std::vector<float> _keyTimes;
+    std::vector<VROMatrix4f> _keyValues;
+    std::function<void(VROAnimatable *const, VROMatrix4f)> _method;
+    SkeletalPoseSample _startPose;
+    float _blendFraction;
+};
+}
